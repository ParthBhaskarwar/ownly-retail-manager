# Environment — Ownly Backend

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ownly_dev

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Backup ─────────────────────────────────────────────────────────────────────
# Directory where backup JSON files are written (created automatically if absent).
# Use an absolute path in production to persist across deployments.
BACKUP_DIR=./backups

# Password set on the synthetic demo store owner by `npm run data:load-synthetic`
SYNTHETIC_OWNER_PASSWORD=
