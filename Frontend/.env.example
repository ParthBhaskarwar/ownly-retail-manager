# Environment Variables Example
# Copy this file to .env.local and fill in values.

# ── App metadata ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Ownly
NEXT_PUBLIC_APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────────────────────
# Leave blank to use local localStorage adapters (Week 0 default)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=10000

# ── Auth ─────────────────────────────────────────────────────────
# Session duration in milliseconds (default: 7 days)
NEXT_PUBLIC_SESSION_DURATION_MS=604800000
# bcrypt rounds for password hashing (10 is standard; don't go below 8)
BCRYPT_ROUNDS=10

# ── Feature flags ────────────────────────────────────────────────
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_DEBUG_MODE=false
